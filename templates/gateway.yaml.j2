apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: "{{ app_name }}-gateway"
  namespace: "{{ k8s_namespace }}"
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-gateway
    field.cattle.io/description: "HTTP gateway for accessing {{ app_name }} as {{ app_public_dns_name }}"
    kubernetes.io/tls-acme: "true"
spec:
  # Traefik Gateway implementation
  gatewayClassName: traefik
  listeners:
    - name: https
      protocol: HTTPS
      # must be 8443 even that Traefik listens on 443
      port: 8443
      hostname: "{{ app_public_dns_name }}"
      # terminate TLS with given ACME-generated certificate
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: "{{ app_public_dns_name | regex_replace('\\.', '-') }}-tls"
      # allows HTTPRoutes from the same namespace
      allowedRoutes:
        namespaces:
          from: Same
