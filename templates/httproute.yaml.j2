apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: "{{ app_name }}-httproute"
  namespace: "{{ k8s_namespace }}"
  annotations:
    field.cattle.io/description: "HTTP route for accessing {{ app_name }} as {{ app_public_dns_name }}"
spec:
  hostnames:
    - "{{ app_public_dns_name }}"
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: "{{ app_name }}-gateway"
      sectionName: https
  rules:
    - backendRefs:
        - kind: Service
          name: "{{ app_name }}-service"
          port: 80
      matches:
        - path:
            type: PathPrefix
            value: /
