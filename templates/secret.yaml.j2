apiVersion: v1
kind: Secret
metadata:
  name: "{{ app_name }}-secret"
  namespace: "{{ k8s_namespace }}"
  annotations:
    field.cattle.io/description: "mounted as a dir with a properties file read by Spring Boot"
type: Opaque
data:
  {{ secret_data | to_nice_yaml(default_style="\"",sort_keys=false,indent=2) | indent(2) }}
